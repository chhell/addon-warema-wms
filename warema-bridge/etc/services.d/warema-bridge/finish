#!/usr/bin/env bashio
# ==============================================================================
# Take down the add-on when the Warema bridge fails, so the Supervisor
# watchdog can restart it
# ==============================================================================
if [[ "${1}" -ne 0 ]] && [[ "${1}" -ne 256 ]]; then
  bashio::log.warning "Warema bridge exited with code ${1}, halting add-on"
  exec /run/s6/basedir/bin/halt
fi
